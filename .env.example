# Servidor. O backend chama a IA em FLASK_API_URL (padrão http://localhost:5000);
# se mudar a porta aqui, mude lá também.
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Endereços do front, separados por vírgula (a API é chamada server-to-server pelo backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modelos por cultura. Cultura sem arquivo é ignorada (não derruba a API).
# Sem aspas: o `docker run --env-file` não remove aspas.
COFFEE=./models/Coffee/coffee.pth
SOYBEAN=./models/Soybean/soybean_v2.pth
TOMATO=./models/Tomato/tomato.pth
WHEAT=./models/Wheat/wheat.pth
CORN=./models/Corn/corn.pth

# Triagem (folha / não-folha / qualidade). Sem ela, só a resolução mínima é verificada.
GATE=./models/Gate/gate.pth

# Opcionais (valores padrão)
# MAX_UPLOAD_MB=8
# DEVICE=cpu
# REVIEW_THRESHOLD=0.6
# CONFIDENT_THRESHOLD=0.8
# GATE_NOT_LEAF_THRESHOLD=0.5
# GATE_POOR_THRESHOLD=0.5
